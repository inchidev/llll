# Portal operator configuration. Keep real values in an ignored file or secret store.
# Release versions are NOT pinned here: the user picks a published GitHub
# release on /deploy and the portal verifies its SHA256SUMS + module hashes.
PUBLIC_ORIGIN=https://llll.gg
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLOUDFLARE_OAUTH_CLIENT_ID=replace-with-your-public-PKCE-client-id
