{
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2022"
    ],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "~~/*": [
        "../../*"
      ]
    }
  },
  "include": [
    "capacitor.config.ts",
    "src/**/*.ts"
  ]
}
