{
  "name": "@llll/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ios:sync": "node scripts/build.mjs && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios",
    "android:sync": "node scripts/build.mjs && cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@capacitor/local-notifications": "8.3.1",
    "@capawesome/capacitor-badge": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "esbuild": "0.28.1",
    "typescript": "5.9.2"
  }
}
