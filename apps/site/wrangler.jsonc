{
  "name": "llll", "main": ".bundle/index.mjs", "compatibility_date": "2026-10-16",
  "preview_urls": true,
  "assets": { "binding": "ASSETS", "directory": ".output/public", "html_handling": "auto-trailing-slash", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "PORTAL_DB", "database_name": "llll-portal", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "PUBLIC_ORIGIN": "https://llll.gg", "CLOUDFLARE_OAUTH_CLIENT_ID": "080a432190799c0ffd21a0348993ccc5" }, "observability": { "enabled": true, "redact_query_string": true }, "triggers": { "crons": ["31 * * * *"] },
  "previews": {
    "d1_databases": [{ "binding": "PORTAL_DB", "database_name": "llll-portal-staging", "database_id": "00000000-0000-4000-8000-000000000001", "migrations_dir": "migrations" }]
  }
}
