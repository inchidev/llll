{
  "name": "@llll/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The account-local L4 Admin Worker",
  "scripts": {
    "prebuild": "pnpm --filter @llll/admin-core build",
    "build": "nuxt build",
    "bundle": "pnpm build && wrangler deploy --dry-run --outdir .bundle",
    "predev": "pnpm --filter @llll/admin-core build",
    "dev": "nuxt dev",
    "postinstall": "nuxt prepare",
    "pretypecheck": "pnpm --filter @llll/admin-core build",
    "typecheck": "nuxt typecheck",
    "dev:worker": "pnpm build && wrangler dev -c wrangler.dev.jsonc --port 8790"
  },
  "dependencies": {
    "@llll/admin-core": "workspace:*",
    "@iconify-json/ph": "^1.2.2",
    "@nuxt/ui": "^4.11.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.142.0"
  }
}
