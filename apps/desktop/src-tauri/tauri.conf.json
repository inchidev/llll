{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L4",
  "version": "0.1.0",
  "identifier": "gg.llll.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "SocialNetworking",
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "gif", "webp", "mov", "mp4", "m4v", "webm"],
        "name": "Screenshot or screen recording",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "shortDescription": "Open your L4 Servers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "PlugIns/L4Share.appex": "../share-extension/build/L4Share.appex"
      },
      "signingIdentity": "-"
    }
  }
}
