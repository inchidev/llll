# Operator bootstrap configuration. Copy to an ignored .env in a fresh checkout,
# or add these fields to your existing ignored env without replacing its secrets.
# Run: pnpm build:deployment && pnpm deploy:instance
# These credentials create the installation; provision servers afterwards from
# Installation settings, or register servers you deployed separately.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-your-scoped-cloudflare-api-token
INSTALLATION_ID=community
INSTALLATION_NAME=My L4
# Optional comma-separated common clients allowed to connect.
CLIENT_ORIGINS=https://llll.gg
EMBED_ORIGINS=https://llll.gg
# The installer generates auth/setup secrets and preserves them in private
# .deployment/<INSTALLATION_ID>.json. Retain that state file for updates.
