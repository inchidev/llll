{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llll-dev",
  // Local Nuxt skips AI and Browser: those bindings
  // start a remote wrangler session and fail without CLOUDFLARE_API_TOKEN.
  "main": "workers/index.ts",
  "compatibility_date": "2026-10-16",
  "triggers": { "crons": ["17 4 * * 1"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llll",
      "database_id": "local-llll",
      "migrations_dir": "drizzle/server-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "llll-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TICKETS",
      "id": "local-tickets"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL_DO", "class_name": "ChannelDurableObject" },
      { "name": "SERVER_DO", "class_name": "ServerDurableObject" },
      { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDurableObject" },
      { "name": "NOTIFICATION_DO", "class_name": "NotificationDurableObject" },
      { "name": "AGENT_DO", "class_name": "L4Agent" },
      { "name": "AGENT_RUN_DO", "class_name": "AgentRunDurableObject" },
      { "name": "AGENT_SCHEDULE_DO", "class_name": "AgentScheduleDurableObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChannelDurableObject", "ServerDurableObject", "RateLimitDurableObject", "NotificationDurableObject", "L4Agent", "L4Think"] }, { "tag": "v2-agent-runs", "new_sqlite_classes": ["AgentRunDurableObject"] }, { "tag": "v3-agent-schedules", "new_sqlite_classes": ["AgentScheduleDurableObject"] }, { "tag": "v4-retire-think", "deleted_classes": ["L4Think"] }],
  "vars": {
    "AGENT_MODEL": "@cf/moonshotai/kimi-k2.7-code"
  }
}
