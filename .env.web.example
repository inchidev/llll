# Web operator configuration. Keep real values in an ignored file or secret store.
# Release versions are NOT pinned here: the user picks a published GitHub
# release on /create and the website verifies its SHA256SUMS + module hashes.
PUBLIC_ORIGIN=https://llll.gg
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Public PKCE client id (not a secret). Lives in apps/site/wrangler.jsonc vars
# so pipeline deploys never wipe it; the placeholder below is for other setups.
CLOUDFLARE_OAUTH_CLIENT_ID=replace-with-your-public-PKCE-client-id
# Optional: any GitHub PAT (no scopes needed for public repos) to raise the
# /api/deploy/releases quota. Set as a worker secret, never in this file.
