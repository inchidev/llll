# Standalone Server development. See docs/deployment.md for Git-connected Builds.
# pnpm env:init creates private local AUTH_SECRET and SETUP_TOKEN values.
AUTH_SECRET=replace-with-a-random-secret
SETUP_TOKEN=replace-with-a-random-secret
ADMIN_EMAIL=owner@example.com
APP_NAME=L4
APP_TITLE=Your community, together.
APP_SUBTITLE=Built on your Cloudflare stack.
AUTH_REGISTRATION_MODE=invite_only

# Set the exact origin when running the built local Worker or behind a proxy.
# PUBLIC_ORIGIN=http://localhost:3000
# LLLL_DEV_PROXY_ORIGIN=https://chat.example.com
# EMBED_ORIGINS=https://your-shell.example.com

# Optional login providers. Deployment secrets override owner-managed settings.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TELEGRAM_CLIENT_ID=
# TELEGRAM_CLIENT_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Verification email requires a configured sender and Email Service binding.
# EMAIL_FROM=login@example.com
# EMAIL_FROM_NAME=L4

# Optional Web Push: keep one stable key pair while subscriptions are active.
# VAPID_SUBJECT=mailto:owner@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional RealtimeKit. Configure production secrets through the deployment operator.
# REALTIMEKIT_ACCOUNT_ID=
# REALTIMEKIT_APP_ID=
# REALTIMEKIT_API_KEY=
# REALTIMEKIT_API_SECRET=
# REALTIMEKIT_PRESET_VOICE=voice
# REALTIMEKIT_PRESET_AV=group_call_host
