# Server runtime/development configuration. For creating an installation,
# use .env.installation.example and docs/deployment.md.
# Required for this server. `pnpm env:init` generates this locally.
AUTH_SECRET=replace-with-a-random-secret

# Optional explicit origin override. Set the exact public origin, without a path.
# PUBLIC_ORIGIN=https://chat.example.com

# Local frontend-only development target used by `pnpm dev:remote`.
# This is never used by production builds or deployments.
# LLLL_DEV_PROXY_ORIGIN=https://chat.example.com

# Public app copy. The logo remains the L4 mark. Use \n for a deliberate
# line break in the title; the final line receives the Cloudflare-orange accent.
APP_NAME=L4
APP_TITLE=Your community, together.
APP_SUBTITLE=Built on your Cloudflare stack.

# Initial policy only. Once the auth settings row exists, the owner controls it
# in Server settings -> Authentication for standalone servers.
# Connected installation accounts are configured on the installation instead.
AUTH_REGISTRATION_MODE=invite_only

# Optional deployment-managed auth credentials. These override credentials
# entered in the owner UI. Provider callback paths are shown in that UI.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google callback: https://your-domain.example/api/auth/callback/google
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LinkedIn callback: https://your-domain.example/api/auth/callback/linkedin
# Enable "Sign In with LinkedIn using OpenID Connect" in the LinkedIn app.

# Optional X sign-in. In the X developer app, set the production callback to:
# https://your-domain.example/api/auth/callback/twitter
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TELEGRAM_CLIENT_ID=
# TELEGRAM_CLIENT_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Verification email sender. Cloudflare deployments also need an EMAIL
# `send_email` binding and an onboarded Email Service sending domain.
# EMAIL_FROM=login@example.com
# EMAIL_FROM_NAME=L4

# Optional Web Push. Generate one stable key pair with `pnpm vapid:generate`.
# All three values must remain unchanged while subscriptions are active.
# VAPID_SUBJECT=mailto:admin@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# First-run owner. If both email and password are set and the database is empty,
# L4 creates the workspace and this account (no /setup form).
# The Deploy to Cloudflare form stores these as encrypted Worker secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Admin
# ADMIN_HANDLE=admin
# APP_NAME=L4
# ADMIN_WORKSPACE=HQ

# Optional RealtimeKit huddles (server-only; use `wrangler secret put` in production)
# REALTIMEKIT_ACCOUNT_ID=
# REALTIMEKIT_APP_ID=
# REALTIMEKIT_API_KEY=
# REALTIMEKIT_API_SECRET=
# REALTIMEKIT_PRESET_VOICE=voice
# REALTIMEKIT_PRESET_AV=group_call_host
