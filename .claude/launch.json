{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-remote",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev:remote",
        "--",
        "--env-file",
        ".env.remote"
      ],
      "port": 3000
    },
    {
      "name": "stack",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/local-stack.mjs",
        "dev"
      ],
      "port": 3000
    }
  ]
}
