# Copy to .env and replace every placeholder. .env is gitignored.
# AUTH_SECRET and SETUP_TOKEN must each be at least 32 characters.
# Generate them with: openssl rand -hex 32

PUBLIC_ORIGIN=http://127.0.0.1:8080
# Optional comma-separated aliases. The VPS installer manages this with `llll domain`.
LLLL_ORIGINS=
# Caddy gateway's host port and bind address. celld and RustFS stay private.
LLLL_HTTP_PORT=8080
LLLL_BIND=127.0.0.1
# Set after loading a checksum-verified release; omitted for compose.build.yml.
# LLLL_IMAGE=llll:<version>
AUTH_SECRET=replace-with-32-or-more-random-characters
ADMIN_EMAIL=owner@example.com
# Optional, at least 12 characters: the first start creates the Owner with this
# password, so /setup and SETUP_TOKEN are not needed. Change it after signing in.
# ADMIN_PASSWORD=
SETUP_TOKEN=replace-with-32-or-more-random-characters
# SERVER_ID is generated by the installer. The UUID names the Server, its resources and its backups.

# RustFS credentials. These are the S3 keys for the fleet bucket, not Worker secrets.
RUSTFS_ACCESS_KEY=replace-with-an-access-key
RUSTFS_SECRET_KEY=replace-with-a-secret-key
RUSTFS_BUCKET=cells
AWS_REGION=us-east-1

# Optional Cloudflare REST fallback (Workers AI, Browser Run, Email Sending, RealtimeKit).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional OpenAI-compatible model. Set all three, or leave them unset.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# Optional outbound mail. Use one gateway.
# MAIL_GATEWAY_URL=
# MAIL_GATEWAY_TOKEN=
# SMTP_GATEWAY_URL=
# SMTP_GATEWAY_TOKEN=
# LLLL_EMAIL_DOMAINS=[]
# MAIL_APP_HOSTNAME=
# MAIL_DEFAULT_LOCAL_PART=

# Optional inbound mail. Each secret must be at least 32 characters.
# INBOUND_EMAIL_SECRET=
# POSTMARK_INBOUND_SECRET=
# MAILGUN_WEBHOOK_SIGNING_KEY=
# SES_SNS_TOPIC_ARN=

# Optional Chromium DevTools endpoint. Keep it private.
# BROWSER_CDP_URL=

# Optional governed Pi executor: add compose.agents.yml and see docs/agents.md.
# GITHUB_AGENT_APP_ID=
# GITHUB_AGENT_APP_PRIVATE_KEY=
# EXA_API_KEY=
